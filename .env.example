# Copy to .env (never commit .env). Every value is optional.
# Login token for the web UI; required when LvW listens on anything but 127.0.0.1.
LVW_TOKEN=change-me
# Where LvW keeps models, memory and settings (default ~/.lvw).
# LVW_HOME=/data
# Tokens for gated or private models. You can also use `lvw login hf|gh|gl`.
# HF_TOKEN=
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# LVW_GITLAB_URL=https://gitlab.example.com
# Telegram bot token from @BotFather, for `lvw telegram`.
# LVW_TELEGRAM_TOKEN=
